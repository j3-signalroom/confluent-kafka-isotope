-- ============================================================================
-- Typed view of the isotope-tagged stream
--
-- Decodes the seven scalar reporting headers written by
-- IsotopeProducerInterceptor into properly-typed columns and computes a
-- per-record latency (broker-arrival time minus origin timestamp).
--
-- Depends on:
--   - isotope_raw, which provides the columns `headers`, `event_time`,
--     `kafka_topic`. Both cp/00_source_table.sql and cc/00_source_table.sql
--     create that shape under the name `isotope_raw`.
--
-- All downstream reports read from this view, so they are identical across
-- CCAF and CP Flink.
-- ============================================================================

CREATE VIEW IF NOT EXISTS isotope AS
SELECT
    CAST(`headers`['x-isotope-trace-id']                          AS STRING) AS trace_id,
    CAST(CAST(`headers`['x-isotope-origin-ts']      AS STRING)    AS BIGINT) AS origin_ts_ms,
    CAST(`headers`['x-isotope-origin-service']                    AS STRING) AS origin_service,
    CAST(`headers`['x-isotope-pipeline']                          AS STRING) AS pipeline,
    CAST(`headers`['x-isotope-this-service']                      AS STRING) AS this_service,
    CAST(`headers`['x-isotope-this-topic']                        AS STRING) AS this_topic,
    CAST(CAST(`headers`['x-isotope-hop-count']      AS STRING)    AS INT)    AS hop_count,
    `event_time`,
    -- Latency from origin to this hop, in milliseconds.
    --
    -- NOT TIMESTAMPDIFF(MILLISECOND, ...): on Flink 2.1 it truncates to whole
    -- seconds — 177ms comes back as 0, 1s as 1000 — so every sub-second hop
    -- (which is every hop in the demo) read as 0 latency. Instead the event's
    -- epoch milliseconds are rebuilt exactly and the origin's subtracted:
    --
    --   * TIMESTAMPDIFF(SECOND, epoch, event_time) — whole seconds between two
    --     INSTANTS, so table.local-time-zone cannot shift it (EXTRACT(EPOCH)
    --     would: it reads the local wall clock). CAST to BIGINT before the
    --     * 1000, or INT overflows.
    --   * EXTRACT(MILLISECOND) — the millisecond-of-second field (0..999),
    --     which no real zone offset changes.
    --
    -- Pinned by IsotopeViewSqlTest under UTC and America/New_York. The outer
    -- CAST keeps latency_ms an INT, the type every consumer was written for.
    CAST(
        CAST(TIMESTAMPDIFF(SECOND, TO_TIMESTAMP_LTZ(0, 3), `event_time`) AS BIGINT) * 1000
        + EXTRACT(MILLISECOND FROM `event_time`)
        - CAST(CAST(`headers`['x-isotope-origin-ts'] AS STRING) AS BIGINT)
    AS INT) AS latency_ms
FROM isotope_raw
WHERE `headers`['x-isotope-trace-id']        IS NOT NULL
  -- Exclude consume-edge markers (records on
  -- isotope_consume_edge_markers). They forward all seven produce-side
  -- scalar headers, but additionally carry x-isotope-consumer-service.
  -- Filtering by its absence keeps this view restricted to genuine produced
  -- records; consume markers feed the separate consume_events view (see
  -- 06_consume_events_view.fql).
  AND `headers`['x-isotope-consumer-service'] IS NULL;
