-- ================================================================================
-- Teardown — drops the 6 report sink tables + upstream view + source table +
-- functions. Safe to run repeatedly; uses IF EXISTS.
--
-- Reference teardown DDL (mirrors the CCAF drop set). The CP reports now run as a
-- Flink 2.1 CMF Application, so `make cp-flink-reports-down` tears them down by
-- deleting the CMF Application + cmf:// artifact + Kafka sink topics — not by
-- applying this file. Kept as the portable drop-SQL companion to sql/cp/.
-- ================================================================================

-- Sink tables (each backed by an isotope-report-* Kafka topic + SR Avro subject).
DROP TABLE    IF EXISTS latency_percentiles_flat_1m;
DROP TABLE    IF EXISTS coverage_report_1m;
DROP TABLE    IF EXISTS hop_distribution_1m;
DROP TABLE    IF EXISTS bipartite_topology_report_1m;
DROP TABLE    IF EXISTS topology_report_1m;
DROP TABLE    IF EXISTS latency_report_1m;

-- Collector-side (in-band propagation) sink — the topic Flink produces to.
-- See docs/flink-collector.md.
DROP TABLE    IF EXISTS `orders.flink_enriched`;

-- Optional fan-in provenance (docs/flink-collector.md 2.4). Dropped
-- unconditionally: IF EXISTS makes this a no-op when the feature was never on,
-- and a teardown must not strand tables an earlier enabled run created.
DROP TABLE    IF EXISTS `orders.flink_batched`;
DROP TABLE    IF EXISTS `isotope_merge_edge_markers`;
DROP TABLE    IF EXISTS `isotope_state_provenance`;
DROP VIEW     IF EXISTS `entity_log`;

-- Upstream typed views → source table.
DROP VIEW     IF EXISTS consume_events;
DROP VIEW     IF EXISTS isotope;
DROP TABLE    IF EXISTS isotope_raw;

-- Functions (no dependents after the tables above are gone).
DROP FUNCTION IF EXISTS STUCK_TRACE_PTF;
DROP FUNCTION IF EXISTS LATENCY_PERCENTILES;
DROP FUNCTION IF EXISTS ISOTOPE_APPEND_HOP;
DROP FUNCTION IF EXISTS ISOTOPE_MERGE_TRACE;
DROP FUNCTION IF EXISTS ISOTOPE_MERGE_TRACE_ID;
DROP FUNCTION IF EXISTS STATE_PROVENANCE;
